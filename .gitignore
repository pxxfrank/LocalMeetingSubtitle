# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# Test results
/TestResults/
*.trx
*.coverage
/coverage/

# Locally downloaded ASR models (root-anchored! an unanchored "models/" would also
# ignore src/LocalMeetingSubtitle.Core/Models/ because git is case-insensitive on Windows).
/models/

# Distribution artifacts
/dist/
/artifacts/

# Third-party redistributable binaries (FFmpeg LGPL build). Downloaded by
# tools/fetch-ffmpeg.ps1; not committed (large binaries + LGPL "separate program").
/third_party/

# Generated media used for real decode tests (gitignored; produced by ffmpeg)
/testmedia/

# Local runtime data
/data/
/logs/
*.log

# WiX generated component list (contains absolute paths; regenerated per machine)
installer/GeneratedFiles.wxs

# Secrets / local environment
.env
appsettings.local.json

# OS
Thumbs.db
desktop.ini

# Stray capture output
*.wav
