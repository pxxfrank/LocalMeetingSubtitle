<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    字幕君 installer (per-user, no admin required).
    Installs the self-contained build into %LOCALAPPDATA%\Programs\字幕君
    and creates a Start-menu shortcut. User data still lives in
    %LOCALAPPDATA%\字幕君 and is NOT touched by install/uninstall.
  -->
  <Package Name="字幕君"
           Manufacturer="字幕君"
           Version="0.3.9"
           UpgradeCode="b7e1c2d3-4a5f-4e6b-9c8d-1f2a3b4c5d6e"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of 字幕君 is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <!-- ASCII on purpose: sherpa-onnx's native layer cannot read model files from a path with
             non-ASCII characters, so the install folder (which holds models\) must stay ASCII. -->
        <Directory Id="INSTALLFOLDER" Name="SubtitleJun" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="字幕君" />
    </StandardDirectory>

    <Feature Id="Main" Title="字幕君" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="a1b2c3d4-5566-4778-99aa-bbccddeeff00">
      <Shortcut Id="AppShortcut"
                Name="字幕君"
                Description="Offline real-time meeting subtitles"
                Target="[INSTALLFOLDER]字幕君.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\字幕君"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
