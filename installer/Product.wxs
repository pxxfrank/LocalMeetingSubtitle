<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    LocalMeetingSubtitle installer (per-user, no admin required).
    Installs the self-contained build into %LOCALAPPDATA%\Programs\LocalMeetingSubtitle
    and creates a Start-menu shortcut. User data still lives in
    %LOCALAPPDATA%\LocalMeetingSubtitle and is NOT touched by install/uninstall.
  -->
  <Package Name="LocalMeetingSubtitle"
           Manufacturer="LocalMeetingSubtitle"
           Version="0.3.0"
           UpgradeCode="b7e1c2d3-4a5f-4e6b-9c8d-1f2a3b4c5d6e"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of LocalMeetingSubtitle is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="LocalMeetingSubtitle" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="LocalMeetingSubtitle" />
    </StandardDirectory>

    <Feature Id="Main" Title="LocalMeetingSubtitle" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="a1b2c3d4-5566-4778-99aa-bbccddeeff00">
      <Shortcut Id="AppShortcut"
                Name="LocalMeetingSubtitle"
                Description="Offline real-time meeting subtitles"
                Target="[INSTALLFOLDER]LocalMeetingSubtitle.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\LocalMeetingSubtitle"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
