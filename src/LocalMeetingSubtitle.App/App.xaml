<Application x:Class="LocalMeetingSubtitle.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!-- Active theme (swapped at runtime by ThemeManager). -->
                <ResourceDictionary Source="pack://application:,,,/Theme/Claude.Light.xaml" />
                <!-- Flat Claude-style control styles (merged after the theme so DynamicResource resolves). -->
                <ResourceDictionary Source="pack://application:,,,/Theme/Controls.xaml" />
                <!-- Line icons. -->
                <ResourceDictionary Source="pack://application:,,,/Theme/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
