<Application x:Class="LocalMeetingSubtitle.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalMeetingSubtitle.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Shared look for the main window. -->
        <SolidColorBrush x:Key="AppAccentBrush" Color="#2D7FF9" />
        <SolidColorBrush x:Key="AppPanelBrush" Color="#F5F6F8" />
        <SolidColorBrush x:Key="AppWarningBrush" Color="#FFF4CE" />
        <SolidColorBrush x:Key="AppWarningBorderBrush" Color="#E8C55A" />

    </Application.Resources>
</Application>
