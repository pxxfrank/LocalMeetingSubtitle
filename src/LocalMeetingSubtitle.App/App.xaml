<Application x:Class="LocalMeetingSubtitle.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!-- Google Material Design 3 (Material You). MIT-licensed library. -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Icon-only button, derived from the implicit Material button style so it always exists. -->
            <Style x:Key="AppIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="3,0" />
            </Style>

            <!-- Filled (primary) button for the main call to action. -->
            <Style x:Key="AppPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="3,0" />
            </Style>

            <Style x:Key="AppActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="3,0" />
            </Style>

            <!-- A Material "card" surface used for the grouped sections. -->
            <Style x:Key="AppCard" TargetType="materialDesign:Card">
                <Setter Property="Margin" Value="12,6,12,6" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="UniformCornerRadius" Value="12" />
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            </Style>

            <Style x:Key="AppCardFill" TargetType="materialDesign:Card">
                <Setter Property="Margin" Value="12,6,12,10" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UniformCornerRadius" Value="12" />
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            </Style>

            <Style x:Key="AppCaption" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="AppFieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Opacity" Value="0.85" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
