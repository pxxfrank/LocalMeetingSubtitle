<Window x:Class="LocalMeetingSubtitle.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 / Settings"
        Height="660" Width="560" MinHeight="440" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource BgApp}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                      Fill="Transparent" Width="20" Height="20" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="设置 / Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Success}" FontWeight="SemiBold" FontSize="12.5"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}" Margin="0,0,6,0">
                        <TextBlock Text="保存 / Save" Foreground="{DynamicResource TextOnAccent}"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding CloseCommand}" IsCancel="True">
                        <TextBlock Text="关闭 / Close" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,16,18,18">

                <!-- ===== 字幕字体 / Subtitle font ===== -->
                <TextBlock Text="字幕字体 / Subtitle font" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="字体 / Family:" VerticalAlignment="Center"
                               Margin="0,0,10,12" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" IsEditable="True"
                              ItemsSource="{Binding AvailableFontFamilies}"
                              Text="{Binding SubtitleFontFamily, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="字号 / Size:" VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                             Text="{Binding SubtitleFontSize}" />
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderDefault}" Margin="0,16" />

                <!-- ===== 悬浮字幕 / Floating subtitles ===== -->
                <TextBlock Text="悬浮字幕 / Floating subtitles" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="字号 / Font size:" FontSize="12" Foreground="{DynamicResource TextMuted}"
                           Margin="0,0,0,2" />
                <Slider Minimum="12" Maximum="96" TickFrequency="2" IsSnapToTickEnabled="True"
                        Value="{Binding FloatingFontSize}" />
                <TextBlock Text="背景不透明度 / Background opacity:" FontSize="12"
                           Foreground="{DynamicResource TextMuted}" Margin="0,10,0,2" />
                <Slider Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Value="{Binding FloatingBackgroundOpacity}" />
                <CheckBox Content="鼠标穿透 / Click-through (可从托盘菜单关闭)" Margin="0,12,0,0"
                          IsChecked="{Binding FloatingClickThrough}" />

                <Border Height="1" Background="{DynamicResource BorderDefault}" Margin="0,16" />

                <!-- ===== 识别 / Recognition ===== -->
                <TextBlock Text="识别 / Recognition" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="线程数 / ASR threads:" VerticalAlignment="Center"
                               Margin="0,0,10,14" />
                    <TextBox Grid.Row="0" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,0,0,14"
                             Text="{Binding AsrNumThreads}" />

                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="启用静音分段（离线模型）/ Enable VAD segmenting (offline models)"
                              IsChecked="{Binding EnableVadSegmenting}" />
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderDefault}" Margin="0,16" />

                <!-- ===== 行为 / Behaviour ===== -->
                <TextBlock Text="行为 / Behaviour" FontWeight="SemiBold" Margin="0,0,0,10" />
                <CheckBox Content="关闭窗口时最小化到托盘 / Minimize to tray on close"
                          IsChecked="{Binding MinimizeToTrayOnClose}" />
                <CheckBox Content="自动滚动到最新字幕 / Auto-scroll to newest" Margin="0,8,0,0"
                          IsChecked="{Binding AutoScrollEnabled}" />
                <CheckBox Content="导出时包含时间戳 / Include timestamps when exporting" Margin="0,8,0,0"
                          IsChecked="{Binding ExportIncludeTimestamps}" />

                <Border Height="1" Background="{DynamicResource BorderDefault}" Margin="0,16" />

                <!-- ===== 外观 / Appearance ===== -->
                <TextBlock Text="外观 / Appearance" FontWeight="SemiBold" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="主题 / Theme:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Width="170" SelectedValue="{Binding Theme}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="浅色 / Light" Tag="Light" />
                        <ComboBoxItem Content="深色 / Dark" Tag="Dark" />
                    </ComboBox>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource BorderDefault}" Margin="0,16" />

                <!-- ===== 会后录音 / Post-meeting recording ===== -->
                <TextBlock Text="会后录音 / Post-meeting recording" FontWeight="SemiBold" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="模式 / Mode:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Width="220" ItemsSource="{Binding RecordingModes}" DisplayMemberPath="Label"
                              SelectedValuePath="Mode" SelectedValue="{Binding RecordingMode}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           Text="默认不录音；选择临时录音时，音频仅保存在本机、用于一次会后分角色分析，并在分析后（或下次启动）自动清除；不上传任何语音数据。" />

                <Border Height="1" Background="{DynamicResource BorderDefault}" Margin="0,16" />

                <!-- ===== 热词 / Hotwords ===== -->
                <TextBlock Text="热词 / Hotwords (每行一个 / one per line)" FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <TextBox Text="{Binding HotwordsText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="130" VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" FontFamily="Consolas"
                         VerticalContentAlignment="Top" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           Text="保存后会重新加载热词；若正在转写，将从下一句话开始生效。/ Saving reloads hotwords; if transcribing, they apply from the next utterance." />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
