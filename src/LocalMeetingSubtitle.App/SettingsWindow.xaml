<Window x:Class="LocalMeetingSubtitle.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 / Settings"
        Height="620" Width="520" MinHeight="420" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#2D7FF9"
                       Margin="0,0,12,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
            <Button Content="保存 / Save" Command="{Binding SaveCommand}" Padding="14,5" Margin="0,0,8,0"
                    Background="{StaticResource AppAccentBrush}" Foreground="White" BorderThickness="0" />
            <Button Content="关闭 / Close" Command="{Binding CloseCommand}" Padding="14,5" IsCancel="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="字幕字体 / Subtitle font" Padding="8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="字体 / Family:" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" IsEditable="True"
                                  ItemsSource="{Binding AvailableFontFamilies}"
                                  Text="{Binding SubtitleFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="字号 / Size:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                 Text="{Binding SubtitleFontSize}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="悬浮字幕 / Floating subtitles" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="字号 / Font size:" Margin="0,0,0,4" />
                        <Slider Minimum="12" Maximum="96" TickFrequency="2" IsSnapToTickEnabled="True"
                                Value="{Binding FloatingFontSize}" />
                        <TextBlock Text="背景不透明度 / Background opacity:" Margin="0,8,0,4" />
                        <Slider Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding FloatingBackgroundOpacity}" />
                        <CheckBox Content="鼠标穿透 / Click-through (可从托盘菜单关闭)" Margin="0,10,0,0"
                                  IsChecked="{Binding FloatingClickThrough}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="识别 / Recognition" Padding="8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="线程数 / ASR threads:" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"
                                 Text="{Binding AsrNumThreads}" />
                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  Content="启用静音分段（离线模型）/ Enable VAD segmenting (offline models)"
                                  IsChecked="{Binding EnableVadSegmenting}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="行为 / Behaviour" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="关闭窗口时最小化到托盘 / Minimize to tray on close"
                                  IsChecked="{Binding MinimizeToTrayOnClose}" />
                        <CheckBox Content="自动滚动到最新字幕 / Auto-scroll to newest" Margin="0,6,0,0"
                                  IsChecked="{Binding AutoScrollEnabled}" />
                        <CheckBox Content="导出时包含时间戳 / Include timestamps when exporting" Margin="0,6,0,0"
                                  IsChecked="{Binding ExportIncludeTimestamps}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="热词 / Hotwords (每行一个 / one per line)" Padding="8">
                    <StackPanel>
                        <TextBox Text="{Binding HotwordsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" FontFamily="Consolas" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#666"
                                   Text="保存后会重新加载热词；若正在转写，将从下一句话开始生效。/ Saving reloads hotwords; if transcribing, they apply from the next utterance." />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
