<Window x:Class="LocalMeetingSubtitle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:LocalMeetingSubtitle.App"
        Title="LocalMeetingSubtitle 本地会议字幕"
        Height="640" Width="1000" MinHeight="440" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Roboto, Segoe UI"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>

        <!-- ================= Top app bar ================= -->
        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="16,12,16,12"
                                  materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Subtitles" Width="28" Height="28"
                                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border DockPanel.Dock="Right" Background="#33FFFFFF" CornerRadius="12" Padding="12,5"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FFFFFF" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="LocalMeetingSubtitle" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <TextBlock Grid.Row="1" Margin="38,6,0,0" Text="{Binding StatusText}" Opacity="0.85"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </materialDesign:ColorZone>

        <!-- ================= Action bar ================= -->
        <materialDesign:Card DockPanel.Dock="Bottom" Margin="12,0,12,12" Padding="12,10"
                             UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <materialDesign:PackIcon Kind="VolumeHigh" VerticalAlignment="Center" Margin="0,0,6,0"
                                             Opacity="0.7" />
                    <ProgressBar Width="130" Height="8" Minimum="0" Maximum="1"
                                 Value="{Binding Level, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AppPrimaryButton}" Command="{Binding StartCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="开始 / Start" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppActionButton}" Command="{Binding PauseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pause" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="暂停 / Pause" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppActionButton}" Command="{Binding ResumeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircle" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="继续 / Resume" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppActionButton}" Command="{Binding StopCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="停止 / Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="#22000000" Margin="8,6" />

                    <Button Style="{StaticResource AppActionButton}" Command="{Binding ToggleSearchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="搜索 / Search" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppActionButton}" Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="导出 / Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppActionButton}" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="设置 / Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppActionButton}" Command="{Binding ToggleFloatingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PictureInPictureBottomRight" VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="悬浮字幕 / Floating" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppActionButton}" Click="OnCopyClick">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="复制 / Copy" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- ================= Status card ================= -->
        <materialDesign:Card DockPanel.Dock="Top" Style="{StaticResource AppCard}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource AppFieldLabel}" Text="音频设备 / Device:" />
                <ComboBox Width="240" Margin="0,0,6,0" ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="FriendlyName"
                          IsEnabled="{Binding CanChangeDevice}"
                          materialDesign:HintAssist.Hint="输出设备"
                          materialDesign:HintAssist.IsFloating="True" />
                <Button Style="{StaticResource AppActionButton}" Command="{Binding RefreshDevicesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="刷新" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Width="1" Background="#22000000" Margin="8,6" />

                <TextBlock Style="{StaticResource AppFieldLabel}" Text="模型 / Model:" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="{Binding ModelName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  (" /><Run Text="{Binding ModelStatusText, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>

                <TextBlock Style="{StaticResource AppFieldLabel}" Text="延迟 / Latency:" />
                <TextBlock Text="{Binding LatencyText}" VerticalAlignment="Center" Width="66" Margin="0,0,16,0" />

                <TextBlock Style="{StaticResource AppFieldLabel}" Text="热词 / Hotwords:" />
                <Border Background="{DynamicResource MaterialDesignChipBackground}" CornerRadius="12"
                        Padding="10,4" VerticalAlignment="Center" ToolTip="{Binding HotwordDetailText}">
                    <TextBlock Text="{Binding HotwordModeText}" Cursor="Help" />
                </Border>
            </WrapPanel>
        </materialDesign:Card>

        <!-- ================= Warning banner (non-modal) ================= -->
        <materialDesign:Card DockPanel.Dock="Top" Margin="12,6" Padding="14,10" UniformCornerRadius="12"
                             Background="#FFF8E1" materialDesign:ElevationAssist.Elevation="Dp0"
                             Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AppIconButton}"
                        Command="{Binding DismissWarningCommand}">
                    <materialDesign:PackIcon Kind="Close" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Alert" Width="22" Height="22"
                                         Foreground="#B26A00" VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" Foreground="#5A4A00" />
            </DockPanel>
        </materialDesign:Card>

        <!-- ================= Search bar ================= -->
        <materialDesign:Card DockPanel.Dock="Top" Style="{StaticResource AppCard}"
                             Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding MatchText}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Style="{StaticResource AppCaption}" />
                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" VerticalAlignment="Center"
                                         Margin="0,0,10,0" />
                <TextBox materialDesign:HintAssist.Hint="查找字幕 / Find in subtitles" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
            </DockPanel>
        </materialDesign:Card>

        <!-- ================= Subtitle stream ================= -->
        <Grid>
            <materialDesign:Card Style="{StaticResource AppCardFill}" Padding="4">
                <ListBox x:Name="SubtitleList"
                         ItemsSource="{Binding Lines}"
                         SelectionMode="Extended"
                         FontFamily="{Binding SubtitleFontFamily}"
                         FontSize="{Binding SubtitleFontSize}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         Padding="4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBg" Padding="6,3" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Ts" Grid.Column="0" Text="{Binding Timestamp}"
                                               Foreground="#8A8A8A" FontFamily="Consolas" Margin="0,0,10,0"
                                               VerticalAlignment="Top" FontSize="12" />
                                    <TextBlock x:Name="Body" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                    <Setter TargetName="Body" Property="TextBlock.FontStyle" Value="Italic" />
                                    <Setter TargetName="Body" Property="TextBlock.Foreground" Value="#9A9A9A" />
                                    <Setter TargetName="Ts" Property="TextBlock.FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                    <Setter TargetName="RowBg" Property="Border.Background" Value="#FFF3C4" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </materialDesign:Card>

            <Button x:Name="ReturnToLatestButton"
                    Style="{StaticResource AppPrimaryButton}"
                    Command="{Binding ReturnToLatestCommand}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,26"
                    Visibility="{Binding ShowReturnToLatest, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowDownBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="返回最新字幕 / Return to latest" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

    </DockPanel>
</Window>
