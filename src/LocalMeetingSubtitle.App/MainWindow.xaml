<Window x:Class="LocalMeetingSubtitle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字幕君"
        Height="640" Width="1000" MinHeight="440" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource BgApp}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>

        <!-- ================= Header (slim, 2 rows) ================= -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCaptions}" Stroke="{DynamicResource Accent}"
                              StrokeThickness="1.6" Fill="Transparent" Width="20" Height="20"
                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="字幕君" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgSubtle}" CornerRadius="8" Padding="10,4"
                                VerticalAlignment="Center" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}"
                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding StateText}" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource BtnIcon}" Click="OnToggleThemeClick"
                                ToolTip="切换主题 / Toggle theme">
                            <Path Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6" Fill="Transparent"
                                  Width="18" Height="18" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconMoon}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconSun}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Button Style="{StaticResource BtnIcon}" Command="{Binding OpenSpeakerManagementCommand}"
                                ToolTip="发言人管理 / Speaker management">
                            <Path Data="{StaticResource IconUsers}" Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource BtnIcon}" Command="{Binding OpenSettingsCommand}"
                                ToolTip="设置 / Settings">
                            <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="1" Margin="30,5,0,0" Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextMuted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- ================= Toolbar ================= -->
        <Border DockPanel.Dock="Top" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="200" ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="FriendlyName"
                              IsEnabled="{Binding CanChangeDevice}"
                              Margin="0,0,6,0" />
                    <Button Style="{StaticResource BtnIcon}" Command="{Binding RefreshDevicesCommand}"
                            ToolTip="刷新设备 / Refresh devices">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" />
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderDefault}" Margin="10,4" />

                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding StartCommand}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource TextOnAccent}"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="开始 / Start" Foreground="{DynamicResource TextOnAccent}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BtnGhost}" Command="{Binding StopCommand}" Margin="0,0,6,0"
                            ToolTip="停止 / Stop">
                        <Path Data="{StaticResource IconStop}" Fill="{DynamicResource Danger}"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                    </Button>

                    <Button Style="{StaticResource BtnGhost}" Command="{Binding PauseCommand}" Margin="0,0,6,0"
                            ToolTip="暂停 / Pause">
                        <Path Data="{StaticResource IconPause}" Fill="{DynamicResource TextSecondary}"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                    </Button>

                    <Button Style="{StaticResource BtnGhost}" Command="{Binding ResumeCommand}"
                            ToolTip="继续 / Resume">
                        <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource TextSecondary}"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="150" Margin="0,0,12,0" VerticalAlignment="Center"
                              ItemsSource="{Binding SpeakerFilters}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSpeakerFilter}"
                              ToolTip="按发言人筛选 / Filter by speaker"
                              Visibility="{Binding HasSpeakerFilter, Converter={StaticResource BoolToVis}}" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"
                               Foreground="{DynamicResource TextMuted}" Text="{Binding LatencyText}" />
                    <Border Background="{DynamicResource BgSubtle}" CornerRadius="8" Padding="10,4"
                            VerticalAlignment="Center" ToolTip="{Binding HotwordDetailText}">
                        <TextBlock Text="{Binding HotwordModeText}" FontSize="12" Cursor="Help"
                                   Foreground="{DynamicResource TextMuted}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Warning banner ================= -->
        <Border DockPanel.Dock="Top" Margin="14,0,14,8" Padding="12,9"
                Background="{DynamicResource WarningBg}"
                BorderBrush="{DynamicResource WarningBorder}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}"
                        Command="{Binding DismissWarningCommand}" ToolTip="关闭 / Dismiss">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Warning}"
                          StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" />
                </Button>
                <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Stroke="{DynamicResource Warning}"
                      StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ================= Diarization progress ================= -->
        <Border DockPanel.Dock="Top" Margin="14,0,14,8" Padding="12,9"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSmall}"
                Visibility="{Binding HasDiarizationStatus, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding DiarizationStatusText}" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                <ProgressBar Height="6" Minimum="0" Maximum="1"
                             Value="{Binding DiarizationProgress, Mode=OneWay}"
                             VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ================= Search bar ================= -->
        <Border DockPanel.Dock="Top" Margin="14,0,14,8" Padding="10,6"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSmall}"
                Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding MatchText}" VerticalAlignment="Center"
                           Margin="12,0,2,0" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                <Path DockPanel.Dock="Left" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMuted}"
                      StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
            </DockPanel>
        </Border>

        <!-- ================= Footer ================= -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="{Binding AudioHealthText}" VerticalAlignment="Center" FontSize="11.5"
                               Margin="0,0,12,0" MaxWidth="440" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAudioHealthWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Path Data="{StaticResource IconVolume}" Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ProgressBar Width="130" Height="6" Minimum="0" Maximum="1"
                                 Value="{Binding Level, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding ToggleSearchCommand}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.6" Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="搜索 / Search" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding ExportCommand}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExport}" Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.6" Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="导出 / Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding ImportAndDiarizeCommand}" Margin="0,0,4,0"
                            ToolTip="导入会议录音，离线识别发言人 / import a recording and diarize speakers">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconUsers}" Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.6" Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="说话人 / Speakers" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Click="OnCopyClick" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCopy}" Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.6" Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="复制 / Copy" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding ToggleFloatingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFloating}" Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.6" Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="悬浮 / Floating" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Subtitle stream ================= -->
        <Grid>
            <Border Margin="14,0,14,12"
                    Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}">
                <ListBox x:Name="SubtitleList"
                         ItemsSource="{Binding Lines}"
                         SelectionMode="Extended"
                         FontFamily="{Binding SubtitleFontFamily}"
                         FontSize="{Binding SubtitleFontSize}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         Padding="4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBg" Padding="6,3" CornerRadius="6"
                                    Visibility="{Binding IsSpeakerVisible, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Ts" Grid.Column="0" Text="{Binding Timestamp}"
                                               Foreground="{DynamicResource TextMuted}" FontFamily="Consolas"
                                               Margin="0,0,10,0" VerticalAlignment="Top" FontSize="12" />
                                    <TextBlock x:Name="SpeakerTag" Grid.Column="1" Text="{Binding SpeakerLabel}"
                                               Foreground="{Binding SpeakerBrush}" FontWeight="SemiBold"
                                               Margin="0,0,10,0" VerticalAlignment="Top" FontSize="12"
                                               Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock x:Name="Body" Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                    <Setter TargetName="Body" Property="TextBlock.FontStyle" Value="Italic" />
                                    <Setter TargetName="Body" Property="TextBlock.Foreground"
                                            Value="{DynamicResource TextMuted}" />
                                    <Setter TargetName="Ts" Property="TextBlock.FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                    <Setter TargetName="RowBg" Property="Border.Background"
                                            Value="{DynamicResource AccentSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NeedsSpeakerConfirmation}" Value="True">
                                    <Setter TargetName="SpeakerTag" Property="TextBlock.FontStyle" Value="Italic" />
                                    <Setter TargetName="SpeakerTag" Property="ToolTip"
                                            Value="自动判定不确定，建议人工确认 / ambiguous – please confirm" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Button x:Name="ReturnToLatestButton"
                    Style="{StaticResource BtnPrimary}"
                    Command="{Binding ReturnToLatestCommand}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,26"
                    Visibility="{Binding ShowReturnToLatest, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource TextOnAccent}"
                          StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="返回最新字幕 / Return to latest" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccent}" />
                </StackPanel>
            </Button>
        </Grid>

    </DockPanel>
</Window>
