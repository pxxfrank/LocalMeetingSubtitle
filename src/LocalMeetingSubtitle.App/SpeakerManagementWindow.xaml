<Window x:Class="LocalMeetingSubtitle.App.SpeakerManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发言人管理 / Speaker management"
        Height="660" Width="840" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource BgApp}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconUsers}" Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                      Fill="Transparent" Width="20" Height="20" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="发言人管理 / Speaker management" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Footer (declared before the status row so the status row sits just above it) -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding SaveNamesCommand}" Margin="0,0,6,0">
                    <TextBlock Text="保存名称 / Save names" Foreground="{DynamicResource TextOnAccent}"
                               VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource BtnGhost}" Command="{Binding ApplyReassignmentsCommand}" Margin="0,0,6,0">
                    <TextBlock Text="应用归属 / Apply" VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource BtnGhost}" Command="{Binding RefreshCommand}" Margin="0,0,6,0"
                        ToolTip="重新加载 / reload">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.6" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="刷新 / Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnGhost}" Command="{Binding CloseCommand}" IsCancel="True">
                    <TextBlock Text="关闭 / Close" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Slim status / undo row -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgSubtle}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="90" Height="5" IsIndeterminate="True"
                             VerticalAlignment="Center" Margin="12,0,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}"
                        Command="{Binding UndoMergeCommand}" VerticalAlignment="Center"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="撤销合并 / Undo merge" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" />
                </Button>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}" />
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Margin="18,14,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Speakers ===== -->
            <StackPanel Grid.Row="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AnalysisDurationText}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="发言人 / Speakers" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Margin="0,2,0,8" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"
                           Text="重命名后可「保存名称」。把某人合并到另一个人会将其全部字幕改归属，可用「撤销合并」恢复。/ Rename then save; merging re-points a speaker's segments (undoable)." />

                <Border Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}">
                    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" Padding="6,4">
                        <ItemsControl ItemsSource="{Binding Speakers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="168" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="14" Height="14" Fill="{Binding ColorBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="留空则显示匿名标签 / leave empty for the anonymous label" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12"
                                                   TextAlignment="Right" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Text="{Binding SegmentCount, StringFormat={}{0} 条}" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12"
                                                   Text="{Binding SpeechTimeText}" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   ToolTip="近似值：按归属字幕与分离区间估算 / estimate from assigned segments" />
                                        <ComboBox Grid.Column="5" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ItemsSource="{Binding MergeTargets}" DisplayMemberPath="Name"
                                                  SelectedItem="{Binding MergeTarget}"
                                                  ToolTip="合并到… / merge into…" />
                                        <Button Grid.Column="6" Style="{StaticResource BtnGhost}" VerticalAlignment="Center"
                                                Content="合并 / Merge"
                                                Command="{Binding DataContext.MergeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderDefault}" Margin="0,14" />

            <!-- ===== Segments ===== -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="字幕归属 / Segment speakers" FontWeight="SemiBold"
                           Margin="0,0,0,6" />

                <Border Grid.Row="1" Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}">
                    <ListBox ItemsSource="{Binding Segments}" Background="Transparent" BorderThickness="0"
                             Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="168" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontFamily="Consolas"
                                               FontSize="12" Margin="0,0,10,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}" TextWrapping="Wrap"
                                               Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="2" VerticalAlignment="Top" MinWidth="150"
                                              ItemsSource="{Binding SpeakerChoices}" DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedSpeaker}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Empty-state hint (no session yet) -->
            <TextBlock Grid.Row="2" Text="还没有可管理的会话。请先开始并结束一次会议。/ No session to manage yet."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="420" TextAlignment="Center"
                       Foreground="{DynamicResource TextMuted}"
                       Visibility="{Binding HasNoSession, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </DockPanel>
</Window>
