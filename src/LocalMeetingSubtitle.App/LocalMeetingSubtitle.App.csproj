<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>字幕君</AssemblyName>
    <RootNamespace>LocalMeetingSubtitle.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Pre-JIT the assemblies so the first launch is not dominated by cold JIT (measured
         >40 s on a cold, un-R2R publish vs ~2 s warm). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>
    <TieredCompilation>true</TieredCompilation>
    <!-- WFAC010: the WinForms analyzer wants DPI configured via an API; we keep the
         PerMonitorV2 settings in app.manifest (as provided). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also compiled into the assembly so the tray icon can use the same artwork at 16x16. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalMeetingSubtitle.Core\LocalMeetingSubtitle.Core.csproj" />
    <ProjectReference Include="..\LocalMeetingSubtitle.Audio\LocalMeetingSubtitle.Audio.csproj" />
    <ProjectReference Include="..\LocalMeetingSubtitle.Asr\LocalMeetingSubtitle.Asr.csproj" />
    <ProjectReference Include="..\LocalMeetingSubtitle.ModelDownloads\LocalMeetingSubtitle.ModelDownloads.csproj" />
    <ProjectReference Include="..\LocalMeetingSubtitle.Storage\LocalMeetingSubtitle.Storage.csproj" />
    <ProjectReference Include="..\LocalMeetingSubtitle.Export\LocalMeetingSubtitle.Export.csproj" />
    <ProjectReference Include="..\LocalMeetingSubtitle.Diagnostics\LocalMeetingSubtitle.Diagnostics.csproj" />
  </ItemGroup>

</Project>
