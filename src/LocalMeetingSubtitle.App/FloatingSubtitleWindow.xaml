<Window x:Class="LocalMeetingSubtitle.App.FloatingSubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字幕君 悬浮字幕"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="CanResizeWithGrip" Width="780" Height="180" MinWidth="260" MinHeight="96"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid x:Name="RootGrid" MouseLeftButtonDown="OnDrag">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="关闭鼠标穿透 / Disable click-through" Click="OnDisableClickThrough" />
                <MenuItem Header="隐藏悬浮字幕 / Hide" Click="OnHideFloating" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Backdrop is a separate layer so the text stays fully opaque regardless of opacity.
             Kept dark in both themes: an overlay must work over any content. -->
        <Rectangle RadiusX="12" RadiusY="12" Opacity="{Binding FloatingBackgroundOpacity}">
            <Rectangle.Fill>
                <SolidColorBrush Color="#FF121418" />
            </Rectangle.Fill>
        </Rectangle>

        <!-- 1px soft outline. -->
        <Border CornerRadius="12" BorderBrush="#3DFFFFFF" BorderThickness="1" IsHitTestVisible="False" />

        <!-- Live indicator chip -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,11,0,0"
                Background="#33FFFFFF" CornerRadius="9" Padding="9,3" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="LIVE" Foreground="White" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding FloatingLines}"
                      IsHitTestVisible="False" Focusable="False"
                      Margin="18,40,18,16"
                      VerticalAlignment="Bottom"
                      FontSize="{Binding FloatingFontSize}"
                      Foreground="White">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" Margin="0,4" Foreground="White" LineHeight="{Binding RelativeSource={RelativeSource Self}, Path=FontSize}">
                        <Run Text="{Binding Timestamp, Mode=OneWay}" Foreground="#E08B6D" FontFamily="Consolas" />
                        <Run Text="   " />
                        <Run Text="{Binding Text, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Opacity="0.35" Width="16" Height="16" Margin="0,0,3,3" Foreground="White" />
    </Grid>
</Window>
